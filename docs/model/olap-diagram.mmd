graph TD
    %% Styles
    classDef cube fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef dim fill:#fff3e0,stroke:#e65100,stroke-width:1px;
    classDef hier fill:#f3e5f5,stroke:#4a148c,stroke-width:1px;
    classDef fact fill:#e8f5e9,stroke:#1b5e20,stroke-width:1px;
    classDef calc fill:#fce4ec,stroke:#880e4f,stroke-width:1px,stroke-dasharray: 5 5;

    %% Cube
    CUBE[Cube_1111<br/>Global11_demo]:::cube

    %% Fact
    FACT[(UNITS_FACT<br/>R_SHIP_TO_ID<br/>MONTH_ID / SHIP / DELIVERY<br/>UNITS)]:::fact --> CUBE

    %% Time Dimension (Role Playing)
    subgraph Time [Time Dimensions - Role Playing]
        T1[TIME_DIM<br/>MONTH_ID]:::dim
        T2[TIME_DIM_SHIP<br/>SHIP_MONTH_ID]:::dim
        T3[TIME_DIM_DELIVERY<br/>DELIVERY_MONTH_ID]:::dim
    end
    T1 & T2 & T3 --> CUBE
    T1 -. Rollup + Span/End .-> THier[Year/Quarter/Month]:::hier

    %% Customer Dimension (Ragged)
    subgraph Cust [Customer Dimension - Ragged/Skip-level]
        CUST[CUSTOMER_DIM<br/>ACCOUNT_DET]:::dim
        HIER[SHIP_TO_COUNTRY_HIER<br/>Skip: STATE/COUNTRY<br/>Rollup: CITY -> WAREHOUSE -> SHIP_TO]:::hier
        CALC_ATTR[FULL_ADDRESS<br/>Calculated Attr<br/>IF Address2 IS NA...]:::calc
    end
    CUST --> CUBE
    CUST --> HIER
    CUST -.-> CALC_ATTR

    %% Product Dimension
    PROD[PRODUCT_DIM]:::dim --> CUBE

    %% Measures
    subgraph Measures [Measures]
        MSR1[MSR_1<br/>Basic Measure<br/>Mapped to UNITS_FACT.UNITS<br/>SUM]:::fact
        MSR2[MSR_2<br/>Calculated<br/>TOTAL(MSR_1)]:::calc
        RANK[CALC_MSR1<br/>Calculated<br/>RANK OVER Hierarchy]:::calc
    end
    MSR1 & MSR2 & RANK --> CUBE

    %% Export Note
    EXP[Export to Oracle AW<br/>Mode: Recreate AW<br/>JDBC: Global_11r21<br/>Pre-compute: Enabled]:::calc
    CUBE -.-> EXP
